---
// TODO: confirm which phone number belongs to which member.
const members = [
  { name: '[Member 1 full name]', email: 'c20234061.loraez@csav.edu.ph', phone: '0912 345 6789' },
  { name: '[Member 2 full name]', email: 'c20245392.dequito@csav.edu.ph', phone: '0993 327 2908' },
];
---

<section id="contact" class="section">
  <div class="container wrap">
    <div class="info">
      <h2>Contact</h2>
      <p class="lead">Need a website or a programmer? Send us a message.</p>

      <ul class="people">
        {members.map((m) => (
          <li>
            <h3>{m.name}</h3>
            <p><a href={`mailto:${m.email}`}>{m.email}</a></p>
            <p><a href={`tel:${m.phone.replace(/\s/g, '')}`}>{m.phone}</a></p>
          </li>
        ))}
      </ul>
    </div>

    <form action="mailto:c20234061.loraez@csav.edu.ph" method="post" enctype="text/plain">
      <label>
        Name
        <input type="text" name="name" required autocomplete="name" />
      </label>
      <label>
        Email
        <input type="email" name="email" required autocomplete="email" />
      </label>
      <label>
        Message
        <textarea name="message" rows="5" required></textarea>
      </label>
      <button type="submit" class="btn">Send message</button>
    </form>
  </div>
</section>

<style>
  .wrap {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 4rem;
    align-items: start;
  }
  .info { display: grid; gap: 1.5rem; }
  .lead { font-size: 1.5rem; font-weight: 600; line-height: 1.3; }

  .people { display: grid; gap: 1.5rem; }
  .people li {
    display: grid;
    gap: 0.25rem;
    padding-left: 1.5rem;
    border-left: 8px solid var(--fg);
  }
  .people p { font-weight: 700; }
  .people a { text-decoration: underline; }

  form { display: grid; gap: 1.25rem; }
  label { display: grid; gap: 0.4rem; font-weight: 700; }

  input, textarea {
    font: inherit;
    padding: 0.85rem 1rem;
    color: var(--black);
    background: var(--white);
    border: var(--line) solid var(--black);
    border-radius: 0;
  }
  input:focus, textarea:focus {
    outline: none;
    color: var(--white);
    background: var(--black);
  }

  button { justify-self: start; }
</style>