---
const steps = [
  { title: 'Discuss', text: 'We listen to what you need, who will use it and when it is due.' },
  { title: 'Design', text: 'We sketch the layout and choose colors and type before writing code.' },
  { title: 'Build', text: 'We code the site in Astro, HTML, CSS and JavaScript, and track changes with Git.' },
  { title: 'Test', text: 'We check every page on phones and desktops and fix what breaks.' },
  { title: 'Deliver', text: 'We hand over the finished site and a short guide on how to use it.' },
];
---

<section id="process" class="section">
  <div class="container">
    <div class="head">
      <h2>Process</h2>
      <p>How we take a project from an idea to a working site.</p>
    </div>

    <ol class="grid">
      {steps.map((s, i) => (
        <li class="cell">
          <span class="num">{i + 1}</span>
          <h3>{s.title}</h3>
          <p>{s.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .head { display: grid; gap: 1.25rem; margin-bottom: 3rem; }
  .head p { font-size: 1.2rem; }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    border-top: var(--line) solid var(--black);
    border-left: var(--line) solid var(--black);
  }
  .cell {
    display: grid;
    gap: 0.75rem;
    align-content: start;
    min-height: 200px;
    padding: 1.75rem;
    color: var(--fg);
    background: var(--bg);
    border-right: var(--line) solid var(--black);
    border-bottom: var(--line) solid var(--black);
    transition: color 0.15s ease, background 0.15s ease;
  }
  .cell:hover {
    --fg: var(--on-accent);
    --bg: var(--accent);
  }
  .num { font-size: 2.5rem; font-weight: 900; line-height: 1; }
</style>
