---
// TODO: fill in the real details for each member.
const members = [
  {
    name: '[Member 1 full name]',
    role: '[Course], [Year level]',
    school: 'CSAV',
    bio: '[Two or three sentences about you: what you study, what you enjoy building, and what you want to learn next.]',
    skills: 'Astro, HTML, CSS, JavaScript',
  },
  {
    name: '[Member 2 full name]',
    role: '[Course], [Year level]',
    school: 'CSAV',
    bio: '[Two or three sentences about you: what you study, what you enjoy building, and what you want to learn next.]',
    skills: 'Python, PHP, MySQL, Git',
  },
];
---

<section id="about" class="section">
  <div class="container">
    <div class="intro">
      <h2>About us</h2>
      <p class="lead">
        We are two students who build websites and software.
      </p>
      <p>
        Finora is our aquatic pet store project. It shows how we design and code a complete
        site, and the people behind it are below.
      </p>
    </div>

    <ul class="members">
      {members.map((m) => (
        <li class="member">
          <h3>{m.name}</h3>
          <p class="meta">{m.role}, {m.school}</p>
          <p>{m.bio}</p>
          <p class="skills"><strong>Skills:</strong> {m.skills}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .intro { display: grid; gap: 1.25rem; margin-bottom: 3rem; max-width: 60ch; }
  .lead { font-size: 1.5rem; font-weight: 600; line-height: 1.3; }

  .members {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 3rem;
    align-items: start;
  }
  .member {
    display: grid;
    gap: 0.75rem;
    padding-left: 1.5rem;
    border-left: 8px solid var(--fg);
  }
  .meta { font-weight: 700; }
  .skills { margin-top: 0.5rem; }
</style>