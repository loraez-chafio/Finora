---

<svg
  class="product-art"
  viewBox="0 0 240 170"
  fill="none"
  stroke="currentColor"
  stroke-width="4"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={shapes}
/>

<style>
  .product-art {
    display: block;
    width: 100%;
    height: 100%;
    color: var(--black);
  }
</style>