---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Stroll from '../components/Stroll.astro';

interface Props {
  title?: string;
  description?: string;
}

// Shop pages use the AquaWorld name; every other page uses Finora.
const isShop = Astro.url.pathname.startsWith('/products');

const {
  title = isShop
    ? 'AquaWorld | Aquatic Pet Store'
    : 'Finora | Web and Programming Portfolio',
  description = isShop
    ? 'Fish, turtles, aquarium animals, food, tanks, accessories and maintenance supplies for every aquatic pet.'
    : 'A web and programming portfolio by two students, presented as an aquatic pet store.',
} = Astro.props;

const favicon =
  "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Ccircle cx='32' cy='32' r='30' fill='%23000'/%3E%3Cpath d='M12 32 C20 18, 38 18, 46 32 C38 46, 20 46, 12 32 Z' fill='%23fff'/%3E%3Cpath d='M44 32 L56 22 C54 28, 54 36, 56 42 Z' fill='%23fff'/%3E%3C/svg%3E";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#000000" />
    <link rel="icon" type="image/svg+xml" href={favicon} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,100..900&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <Stroll />
  </body>
</html>